<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Madden Stat Tracker</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header>
    <h1>Madden Stat Tracker</h1>
    <p>Latest data received from the Madden Companion App.</p>
  </header>

  <main>
    <section>
      <h2>Latest export by type</h2>
      <% if (latestByType.length === 0) { %>
        <p class="empty">No exports received yet. Point the Madden Companion App at
          <code>/api/madden-export</code>.</p>
      <% } else { %>
        <% latestByType.forEach(function(row) { %>
          <details class="export-card">
            <summary>
              <strong><%= row.export_type %></strong>
              <span class="meta">
                <%= row.platform ? 'platform: ' + row.platform : '' %>
                <%= row.league_id ? ' league: ' + row.league_id : '' %>
                &middot; received <%= new Date(row.received_at).toLocaleString() %>
              </span>
            </summary>
            <pre><%= JSON.stringify(row.payload, null, 2) %></pre>
          </details>
        <% }); %>
      <% } %>
    </section>

    <section>
      <h2>Recent activity</h2>
      <% if (recent.length === 0) { %>
        <p class="empty">Nothing yet.</p>
      <% } else { %>
        <table>
          <thead>
            <tr><th>Type</th><th>Platform</th><th>League</th><th>Received</th></tr>
          </thead>
          <tbody>
            <% recent.forEach(function(row) { %>
              <tr>
                <td><%= row.export_type %></td>
                <td><%= row.platform || '—' %></td>
                <td><%= row.league_id || '—' %></td>
                <td><%= new Date(row.received_at).toLocaleString() %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
</body>
</html>
