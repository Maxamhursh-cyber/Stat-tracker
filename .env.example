PORT=3000

# Your Postgres connection string, e.g. from Neon (see README.md), or a
# local Postgres instance for development:
# DATABASE_URL=postgres://user:password@localhost:5432/madden_tracker
DATABASE_URL=

# Neon (and most hosted Postgres providers) requires SSL. Leave this on;
# set to "false" only for a local Postgres instance without SSL configured.
DATABASE_SSL=true

# Shared secret required as ?key=<value> on POST /api/madden-export, so
# random visitors can't post fake data into your database. On Render this
# is auto-generated (see render.yaml); for local dev, set any string here.
EXPORT_API_KEY=
