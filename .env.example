PORT=3000

# Provided automatically by Render when a Postgres database is linked to
# this service. For local development, point it at your own Postgres
# instance, e.g.:
# DATABASE_URL=postgres://user:password@localhost:5432/madden_tracker
DATABASE_URL=

# Render's managed Postgres requires SSL. Leave this on for Render and for
# most hosted Postgres providers; set to "false" for a local Postgres
# instance that isn't configured with SSL.
DATABASE_SSL=true

# Shared secret required as ?key=<value> on POST /api/madden-export, so
# random visitors can't post fake data into your database. On Render this
# is auto-generated (see render.yaml); for local dev, set any string here.
EXPORT_API_KEY=
